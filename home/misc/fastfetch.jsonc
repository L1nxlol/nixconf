{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/home/user/config/fastfetch/nyarch.png",
    "height": 15,
    "width": 30,
  
  },
  "display": {
    "color": {
      "keys": "blue",
      "output": "white",
      "title": "cyan",
      "separator": "default"
    },
    "separator": " "
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────────────────────┐"
    },
    {
      "type": "host",
      "key": "  Host"
    },
    {
      "type": "wm",
      "key": "  WM"
    },
    {
      "type": "packages",
      "format": "{all}",
      "key": "  Packages"
    },
    {
      "type": "cpu",
      "key": "  CPU",
      "format": "{cores-logical} @ {name}"
    },
    {
      "type": "memory",
      "key": "  RAM"
    },
    {
      "type": "disk",
      "key": "  Disk",
      "folders": "/home",
      "format": "{size-used} / {size-total}"
    },
    {
      "type": "battery",
      "key": "  Battery"
    },
            {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────┘"
        }
  ]
}
